# Django Settings
SECRET_KEY=django-insecure-hubspot-deals-extraction-secret-key-change-in-prod
DEBUG=True
ALLOWED_HOSTS=*
PORT=8000
HOST=0.0.0.0

# CORS (only used when DEBUG=False; ignored/open when DEBUG=True)
