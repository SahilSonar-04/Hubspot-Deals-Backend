# Django Settings (Secure-by-default for production; set DEBUG=True only for local dev)
SECRET_KEY=generate-a-strong-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8000
HOST=0.0.0.0

# CORS (Comma-separated allowed origins in production)
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Database Settings (Leave DB_HOST empty to use SQLite default for local dev)
DB_HOST=
DB_PORT=5432
DB_NAME=hubspot_deals_db
DB_USER=postgres
DB_PASSWORD=password123

# Hubspot API Credentials
HUBSPOT_DEALS_API_TOKEN=your-hubspot-private-app-token
HUBSPOT_DEALS_API_TIMEOUT=30
HUBSPOT_DEALS_API_MAX_RETRIES=3

# Dedicated API Authentication Token for client requests (Optional fallback)
API_AUTH_TOKEN=

# Token Encryption at Rest (32-byte urlsafe base64 key or auto-derived from SECRET_KEY)
TOKEN_ENCRYPTION_KEY=
